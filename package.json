{
  "name": "codex-run-audit",
  "version": "0.1.0",
  "description": "Local, evidence-first reports for Codex execution exports",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "codex-run-audit": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "check": "npm run typecheck && npm run lint && npm test",
    "demo": "npm run build && node dist/src/cli.js demo --out reports/demo",
    "prepack": "npm run check",
    "prepare": "npm run build",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "playwright": "1.64.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathandavismail-cmyk/codex-run-audit.git"
  },
  "homepage": "https://github.com/nathandavismail-cmyk/codex-run-audit#readme",
  "bugs": {
    "url": "https://github.com/nathandavismail-cmyk/codex-run-audit/issues"
  }
}
